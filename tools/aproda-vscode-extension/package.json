{
    "name": "aproda-aldc",
    "displayName": "Aproda ALDC",
    "description": "Aproda ALDC toolkit for Visual Studio Code projects.",
    "version": "0.1.3",
    "publisher": "aprodaag",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Aproda-AG/ALDC-AL-Development-Collection-Aproda.git"
    },
    "engines": {
        "vscode": "^1.109.0"
    },
    "categories": [
        "Other"
    ],
    "icon": "media/A-ALDC Logo.png",
    "main": "./dist/extension.js",
    "activationEvents": [
        "onStartupFinished"
    ],
    "contributes": {
        "languageModelTools": [
            {
                "name": "aprodaAldc_readConfiguration",
                "displayName": "Read ALDC Configuration",
                "modelDescription": "Read the authoritative aldc.yaml configuration for the current ALDC project. Use this before making a decision that depends on ALDC configuration, including the toolkit root, plans root, Aproda toolkit version, or BCQuality settings. It resolves the repository root from workspace folders, so it works when the repository root is not itself a workspace folder. It is read-only and returns a structured result. Do not use it for general source-code questions.",
                "canBeReferencedInPrompt": true,
                "toolReferenceName": "aldcConfiguration",
                "userDescription": "Read authoritative ALDC project configuration",
                "when": "aprodaAldc.isAlProject"
            }
        ],
        "commands": [
            {
                "command": "aprodaAldc.setup",
                "title": "Aproda ALDC: Configure Settings"
            },
            {
                "command": "aprodaAldc.doctor",
                "title": "Aproda ALDC: Environment Diagnostics"
            },
            {
                "command": "aprodaAldc.repairCache",
                "title": "Aproda ALDC: (Re)build Toolkit Cache"
            },
            {
                "command": "aprodaAldc.showLog",
                "title": "Aproda ALDC: Show Log"
            },
            {
                "command": "aprodaAldc.initProject",
                "title": "Aproda ALDC: Apply Toolkit to Project"
            },
            {
                "command": "aprodaAldc.previewChanges",
                "title": "Aproda ALDC: Preview Update Changes"
            },
            {
                "command": "aprodaAldc.checkForUpdates",
                "title": "Aproda ALDC: Check for Updates"
            },
            {
                "command": "aprodaAldc.checkExtensionUpdates",
                "title": "Aproda ALDC: Check for Extension Updates"
            },
            {
                "command": "aprodaAldc.installBcQuality",
                "title": "Aproda ALDC: Install / Update BCQuality"
            },
            {
                "command": "aprodaAldc.gettingStarted",
                "title": "Aproda ALDC: Open Onboarding Guide"
            },
            {
                "command": "aprodaAldc.openWalkthrough",
                "title": "Aproda ALDC: Open Get Started"
            },
            {
                "command": "aprodaAldc.validate",
                "title": "Aproda ALDC: Validate Installation"
            },
            {
                "command": "aprodaAldc.resetData",
                "title": "Aproda ALDC: Reset Toolkit Cache and Settings"
            }
        ],
        "configuration": {
            "title": "Aproda ALDC",
            "properties": {
                "aprodaAldc.devRoot": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Developer root used by future Aproda ALDC tooling, for example `I:/Florian Köll`."
                },
                "aprodaAldc.bcquality.path": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Central BCQuality-Aproda clone. Defaults to `<developer root>/BCQuality-Aproda`."
                },
                "aprodaAldc.bcquality.setEnvInWorkspace": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Set BCQUALITY_HOME in reconciled workspace settings."
                },
                "aprodaAldc.bcquality.autoFixWorkspacePath": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Keep BCQuality roots and settings aligned in project workspace files."
                },
                "aprodaAldc.gettingStartedUrl": {
                    "type": "string",
                    "default": "https://github.com/Aproda-AG/ALDC-AL-Development-Collection-Aproda/blob/aproda/.github/onboarding.aproda.md",
                    "markdownDescription": "Aproda ALDC onboarding documentation opened by the Onboarding Guide command."
                },
                "aprodaAldc.source.mode": {
                    "type": "string",
                    "default": "managed",
                    "enum": [
                        "managed",
                        "localFork"
                    ],
                    "markdownDescription": "Toolkit source mode. Use `managed` unless you maintain the Aproda toolkit."
                },
                "aprodaAldc.source.forkPath": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Path to a local Aproda ALDC toolkit fork. Used only in `localFork` mode."
                },
                "aprodaAldc.source.repositoryUrl": {
                    "type": "string",
                    "default": "https://github.com/Aproda-AG/ALDC-AL-Development-Collection-Aproda.git",
                    "markdownDescription": "Repository used by the managed toolkit cache."
                },
                "aprodaAldc.channel": {
                    "type": "string",
                    "default": "release",
                    "enum": [
                        "release",
                        "edge",
                        "pinned"
                    ],
                    "markdownDescription": "Toolkit release channel."
                },
                "aprodaAldc.pinnedVersion": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Toolkit version to use when the channel is `pinned`, for example `1.2.0_aproda.9`."
                },
                "aprodaAldc.pwshPath": {
                    "type": "string",
                    "default": "pwsh",
                    "markdownDescription": "PowerShell executable used by later project commands."
                },
                "aprodaAldc.startupCheck.enabled": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Check for a newer Aproda ALDC toolkit when an AL project opens."
                },
                "aprodaAldc.startupCheck.intervalHours": {
                    "type": "number",
                    "default": 24,
                    "minimum": 1,
                    "markdownDescription": "Minimum time between automatic toolkit update checks."
                },
                "aprodaAldc.extensionUpdate.enabled": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Check for and offer to install newer Aproda ALDC VSIX releases."
                }
            }
        },
        "walkthroughs": [
            {
                "id": "aprodaAldc.gettingStarted",
                "title": "Get Started with the Aproda ALDC Toolkit",
                "description": "Configure the extension, apply the toolkit, and prepare the BCQuality knowledge base.",
                "steps": [
                    {
                        "id": "configure",
                        "title": "Configure settings",
                        "description": "[Configure Aproda ALDC settings](command:aprodaAldc.setup).",
                        "media": {
                            "image": "media/A-ALDC Logo.png",
                            "altText": "Aproda ALDC configuration"
                        }
                    },
                    {
                        "id": "applyLayer",
                        "title": "Apply the toolkit",
                        "description": "[Apply the toolkit](command:aprodaAldc.initProject) to the current project.",
                        "media": {
                            "image": "media/A-ALDC Logo.png",
                            "altText": "Aproda ALDC toolkit workflow"
                        }
                    },
                    {
                        "id": "installBcquality",
                        "title": "Install BCQuality",
                        "description": "[Install or update BCQuality](command:aprodaAldc.installBcQuality).",
                        "media": {
                            "image": "media/A-ALDC Logo.png",
                            "altText": "BCQuality knowledge base"
                        }
                    },
                    {
                        "id": "azureCliSetup",
                        "title": "Set up Azure CLI for ADO integration",
                        "description": "Run in a terminal:\n\n```powershell\naz extension add --name azure-devops\naz login --tenant 8ad57af3-4ca5-4c66-bc7d-a52dd71dc7c9 --subscription bdcf3613-1ee6-4c3c-9caf-962112b8a6aa\n```",
                        "media": {
                            "image": "media/A-ALDC Logo.png",
                            "altText": "Azure CLI setup"
                        }
                    },
                    {
                        "id": "readOnboarding",
                        "title": "Read the onboarding guide",
                        "description": "[Open the Aproda ALDC onboarding guide](command:aprodaAldc.gettingStarted).",
                        "media": {
                            "image": "media/A-ALDC Logo.png",
                            "altText": "Aproda ALDC onboarding guide"
                        }
                    }
                ]
            }
        ]
    },
    "scripts": {
        "compile": "node ./node_modules/typescript/lib/tsc.js -p .",
        "watch": "node ./node_modules/typescript/lib/tsc.js -p . --watch",
        "package": "npm run compile && node ./scripts/package.js",
        "lint": "node ./node_modules/typescript/lib/tsc.js --noEmit",
        "test": "npm run compile && node ./test/version-compare.test.js && node ./test/extension-version.test.js && node ./test/reset-data.test.js && node ./test/dev-root.test.js && node ./test/bcquality-workspace.test.js"
    },
    "dependencies": {
        "jsonc-parser": "^3.3.1",
        "yaml": "^2.8.1"
    },
    "devDependencies": {
        "@types/node": "^22.15.3",
        "@types/vscode": "^1.109.0",
        "@vscode/vsce": "^3.6.0",
        "typescript": "^5.8.3"
    }
}